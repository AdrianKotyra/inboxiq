{
  "name": "inboxiq-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "concurrently -k \"vite\" \"tsx watch server/index.ts\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run db:reset && vitest run",
    "db:reset": "RUST_LOG=info prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "start": "node dist/index.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.0",
    "express": "5.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.0.2",
    "concurrently": "9.2.0",
    "prisma": "6.16.0",
    "supertest": "7.1.4",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
